{
  "name": "kalenteri365-fi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/prepare.mjs && node scripts/download-cache.mjs && node scripts/build.mjs && npm run test:generated && node scripts/audit.mjs && npm run check:sitemaps",
    "test": "node scripts/prepare.mjs && node --test tests/*.test.mjs",
    "check": "node scripts/audit.mjs",
    "start": "node scripts/serve.mjs",
    "test:generated": "node --test tests/generated/*.test.mjs",
    "check:technical": "python3 scripts/audit-technical.py",
    "check:accessibility": "node scripts/audit-accessibility.mjs",
    "check:runtime": "node scripts/audit-browser-runtime.mjs",
    "check:lunar-print": "node scripts/audit-lunar-print.mjs",
    "check:menu": "node scripts/audit-menu-viewport.mjs",
    "check:sitemaps": "python3 scripts/audit-sitemaps.py"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/lato": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "astronomy-engine": "2.1.19",
    "pdf-lib": "1.17.1",
    "sharp": "0.35.5"
  },
  "packageManager": "pnpm@12.18.0",
  "devDependencies": {
    "esbuild": "0.28.2",
    "lightningcss": "1.33.0"
  }
}
