{
  "name": "kalenteri365-fi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/prepare.mjs && node scripts/download-cache.mjs && node scripts/build.mjs && npm run test:generated && node scripts/audit.mjs",
