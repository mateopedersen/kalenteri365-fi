  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/lato": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "astronomy-engine": "2.1.19",
    "pdf-lib": "1.17.1",
    "sharp": "0.35.5"
  },
  "packageManager": "pnpm@12.18.0",
  "devDependencies": {
    "esbuild": "0.28.2",
    "lightningcss": "1.33.0"
  }
}
